{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Text Machine",
  "version": "0.1.0",
  "identifier": "fr.textmachine.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Text Machine",
        "width": 1100,
        "height": 800,
        "minWidth": 600,
        "minHeight": 400,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVDODdBRjAyMDcxQTY5RjEKUldUeGFSb0hBcStIN0tPeGVCdUZCUnZJdFY2dXNUWTBYMHJEaGhFY2tMNzNWcFFwNmdPZml5eksK",
      "endpoints": [
        "https://github.com/cosmicsoap/text-machine/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
